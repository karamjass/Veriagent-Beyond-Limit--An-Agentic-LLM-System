# ==============================================================================
# VeriAgent Demo & Deployment Environment Configuration (.env.example)
# Copy this file to .env and configure your values.
# ==============================================================================

# ── General & Server Mode ─────────────────────────────────────────────────────
# Mode: "development", "demo", or "production"
# In "demo" or "production" mode, public demo access code and strong secret keys are enforced.
VERIAGENT_ENV=development
PORT=5000
DEV=0

# ── Security & Authentication ─────────────────────────────────────────────────
# Session signing key. MUST be set to a strong random hex in demo/production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-random-32-byte-hex-string

# Demo Access Gate:
# In demo mode, visitors must enter this code to access the application.
DEMO_ACCESS_CODE=change-this-demo-access-code

# Emergency Kill Switch (Set to 1 to immediately reject all chat/benchmark calls with 503):
ADMIN_KILL_SWITCH=0

# Reverse Proxy / Tunnel Trust:
# Set to 1 only when running behind a trusted reverse proxy (e.g. Cloudflare Tunnel, ngrok)
# so X-Forwarded-For headers are honored for rate limiting.
TRUSTED_PROXY=0

# ── Rate Limiting (In-Memory, Single Worker) ───────────────────────────────────
# Requests per minute allowed per client IP / user
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BURST=5

# Maximum allowed prompt length in characters
MAX_PROMPT_LENGTH=2000

# Concurrency control: maximum simultaneous active LLM generations
MAX_CONCURRENT_GENERATIONS=2

# ── Local Ollama Daemon Configuration ─────────────────────────────────────────
# Must point to a loopback address (127.0.0.1 or localhost)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
CRITIC_MODEL=llama3:latest
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_CONTEXT_TOKENS=2048

# ── Privacy & Audit Logging ───────────────────────────────────────────────────
# Set to 1 to log user prompt text (default 0 keeps prompt text out of logs)
LOG_PROMPTS=0

# ── Database & Optional Production Auth ───────────────────────────────────────
# Local dev defaults to SQLite at instance/veriagent.db.
# Production requires PostgreSQL:
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

